rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    function isValidAccount(data) {
      return data.accountId is string && data.accountId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.accountName is string && data.accountName.size() > 0 && data.accountName.size() <= 100
        && data.active is bool;
    }

    function isValidIncome(data) {
      return data.transactionId is string && data.transactionId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.affiliateAccountId is string && data.affiliateAccountId.size() <= 128
        && data.date is string && data.date.size() <= 20
        && (data.amount is int || data.amount is float) && data.amount >= 0;
    }

    // User profiles & settings
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && existing().userId == userId && incoming().userId == userId && isValidUser(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Affiliate Accounts
    match /affiliateAccounts/{accountId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidAccount(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidAccount(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Income records
    match /incomes/{transactionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidIncome(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidIncome(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
